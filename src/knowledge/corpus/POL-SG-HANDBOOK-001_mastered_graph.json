  "nodes": {
    "clauses": [
      {
        "node_id": "CLAUSE-SG-1.1-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "1.1",
        "title": "Outpatient Sick Leave Allowance",
        "section_ref": "SECTION 1: PAID TIME OFF & LEAVE OPERATIONS",
        "verbatim_text": "Eligible employees and interns receive up to 14 days of paid outpatient sick leave per calendar year, compensated at 100% of their base salary. Part-time and fixed-term employees' leave is prorated based on their contracted working hours.",
        "page_number": 1,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.98
      },
      {
        "node_id": "CLAUSE-SG-1.1-02",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "1.1",
        "title": "Hospitalization Leave Allowance",
        "section_ref": "SECTION 1: PAID TIME OFF & LEAVE OPERATIONS",
        "verbatim_text": "Employees can utilize an additional 46 work days of paid hospitalization leave per year. This is not an extension of outpatient sick leave but is granted for inpatient stays, day surgeries, quarantine orders, or serious medical conditions certified by a medical practitioner employed by an approved hospital.",
        "page_number": 1,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.97
      },
      {
        "node_id": "CLAUSE-SG-1.1-03",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "1.1",
        "title": "Sick Leave Notification & MC Submission",
        "section_ref": "SECTION 1: PAID TIME OFF & LEAVE OPERATIONS",
        "verbatim_text": "You must notify your manager that you need to take sick or hospitalization leave at least one hour before your normal start time. If you are sick for more than two work days, you must submit your sick certificate from a registered medical practitioner via WorkWeek within 48 hours of taking the leave.",
        "page_number": 1,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.96
      },
      {
        "node_id": "CLAUSE-SG-1.2-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "1.2",
        "title": "Vacation Leave Accrual Tier Matrix",
        "section_ref": "SECTION 1: PAID TIME OFF & LEAVE OPERATIONS",
        "verbatim_text": "The number of days accrued is based on years of continuous service: 1 to 6 years of service: 20 days per year. 7 to 10 years of service: 21 days per year. 11+ years of service: 22 days per year. Employees in their first year receive prorated days.",
        "page_number": 2,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.99
      },
      {
        "node_id": "CLAUSE-SG-1.2-02",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "1.2",
        "title": "Vacation Booking Rules & Notice",
        "section_ref": "SECTION 1: PAID TIME OFF & LEAVE OPERATIONS",
        "verbatim_text": "Vacation can be taken in half-day or full-day increments. Shift workers book based on actual shift hours (12-hour shift requires 1.5 vacation days). You must discuss and obtain approval from your manager at least 15 days in advance. Changes/cancellations require 15 days notice.",
        "page_number": 2,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.95
      },
      {
        "node_id": "CLAUSE-SG-1.2-03",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "1.2",
        "title": "Vacation Carryover & Payout Limitations",
        "section_ref": "SECTION 1: PAID TIME OFF & LEAVE OPERATIONS",
        "verbatim_text": "All unused vacation days from the current year carry over for exactly one additional year and must be used by December 31 of the following year or they are forfeited. Altostrat does not pay out unused vacation, except upon country-to-country transfer or termination of employment.",
        "page_number": 2,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.97
      },
      {
        "node_id": "CLAUSE-SG-1.3-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "1.3",
        "title": "Childcare Leave Entitlement",
        "section_ref": "SECTION 1: PAID TIME OFF & LEAVE OPERATIONS",
        "verbatim_text": "Paid childcare leave is available for eligible parents with children under 12: 6 days of paid leave per year if your children are under 7 years old; 2 days of paid leave per year if your youngest child is between 7 and 12 years old; 6 days per year if you have children in both age groups. Unused childcare leave does not carry over.",
        "page_number": 3,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.98
      },
      {
        "node_id": "CLAUSE-SG-2.1-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "2.1",
        "title": "Paid Maternity Leave Baseline & Schedule",
        "section_ref": "SECTION 2: FAMILY-BUILDING & TRANSITION LEAVES",
        "verbatim_text": "Effective 1 April 2026, all eligible employees are entitled to 24 weeks of paid parental leave. Maternity leave can begin up to 28 days before expected due date. The first 8 weeks (56 days) must be taken consecutively. The remaining 16 weeks (80 working days) can be taken flexibly in daily increments over 12 months.",
        "page_number": 4,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.99
      },
      {
        "node_id": "CLAUSE-SG-2.1-02",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "2.1",
        "title": "Shared Parental Leave (SPL) Extension & Donation",
        "section_ref": "SECTION 2: FAMILY-BUILDING & TRANSITION LEAVES",
        "verbatim_text": "Under Phase 2 of Singapore's MSF scheme, parents of Singaporean children born on or after 1 April 2026 are entitled to 10 weeks of shared parental leave. If your spouse donates their portion (up to 10 weeks) of SPL to you, your total paid maternity leave can be extended to 25 or 26 weeks. Proof from LifeSG must be submitted within 4 weeks.",
        "page_number": 4,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.96
      },
      {
        "node_id": "CLAUSE-SG-2.2-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "2.2",
        "title": "Baby Bonding Leave (Global)",
        "section_ref": "SECTION 2: FAMILY-BUILDING & TRANSITION LEAVES",
        "verbatim_text": "Eligible employees can take up to 18 weeks (90 work days) of paid leave per year for welcoming a new child through childbirth, adoption, surrogacy, or fostering. Must be fully utilized within 12 months. Monetary benefit is provided for meals, cleaning, laundry.",
        "page_number": 5,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.98
      },
      {
        "node_id": "CLAUSE-SG-2.3-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "2.3",
        "title": "Ramp-Back Time (Global)",
        "section_ref": "SECTION 2: FAMILY-BUILDING & TRANSITION LEAVES",
        "verbatim_text": "Employees who have taken at least 10 consecutive weeks of maternity, adoption, parental, or baby bonding leave can take up to 2 weeks of paid ramp-back time immediately upon return. They must work a minimum of 50% of normal weekly hours while receiving 100% normal salary.",
        "page_number": 6,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.98
      },
      {
        "node_id": "CLAUSE-SG-3.1-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "3.1",
        "title": "Bereavement Leave (Global)",
        "section_ref": "SECTION 3: OTHER COMPASSIONATE & UNPAID LEAVES",
        "verbatim_text": "Employees can take up to 4 weeks (20 work days for standard 5-day schedule) of paid leave per event for the loss of a close loved one, including pregnancy loss (miscarriage or stillbirth). Must be taken within 12 months. Paid bereavement leave does not apply to pet loss.",
        "page_number": 7,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.99
      },
      {
        "node_id": "CLAUSE-SG-3.2-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "3.2",
        "title": "Carer's Leave (Global)",
        "section_ref": "SECTION 3: OTHER COMPASSIONATE & UNPAID LEAVES",
        "verbatim_text": "Eligible employees can take up to 8 weeks of paid leave per loved one (family member, partner, dependent) per lifetime to care for seriously or terminally ill individuals. Minimum duration is half a work day.",
        "page_number": 7,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.97
      },
      {
        "node_id": "CLAUSE-SG-3.3-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "3.3",
        "title": "Unpaid Time Off & Personal Leave (Global)",
        "section_ref": "SECTION 3: OTHER COMPASSIONATE & UNPAID LEAVES",
        "verbatim_text": "With manager approval, you can take up to 30 calendar days of unpaid time off. Requests past 30 days reclassify as personal leave up to 92 continuous calendar days with manager & director approval. Prerequisites: >=2 years tenure, 'Significant Impact' or higher GRAD rating, and recommended <10 vacation days remaining.",
        "page_number": 8,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.96
      },
      {
        "node_id": "CLAUSE-SG-4.4-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "4.4",
        "title": "Travel Meal Limits & Group Dining",
        "section_ref": "SECTION 4: TRAVEL & EXPENSE (T&E) GUIDELINES",
        "verbatim_text": "Reimbursement for individual meals on global business trips is capped at US $120 (or equivalent) per employee per day. Group meals are capped at US $120/person and the most senior colleague present must pay. Events costing >= US $500 per head require pre-event written VP approval.",
        "page_number": 10,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.98
      },
      {
        "node_id": "CLAUSE-SG-4.2-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "4.2",
        "title": "Expense Submission Timelines & Aged Approvals",
        "section_ref": "SECTION 4: TRAVEL & EXPENSE (T&E) GUIDELINES",
        "verbatim_text": "All travel expenses must be submitted through Concur within 30 days. Claims older than 60 days require Director approval. Claims older than 90 days require VP approval. Claims older than one year are non-reimbursable.",
        "page_number": 9,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.97
      },
      {
        "node_id": "CLAUSE-SG-5.1-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "5.1",
        "title": "Anti-Bribery & Government Ethics Pre-Approvals",
        "section_ref": "SECTION 5: ETHICS, COMPLIANCE, & CONDUCT",
        "verbatim_text": "Zero-tolerance for bribery/corruption. Written pre-approval from RCI team is required before offering anything of value of any amount to US government officials, or >$100 to non-US government officials (or cumulative >$200 in 6 months). Must check 'yes' on government-related flag.",
        "page_number": 12,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.99
      },
      {
        "node_id": "CLAUSE-SG-5.2-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "5.2",
        "title": "Commercial Gifts & Entertainment Approvals",
        "section_ref": "SECTION 5: ETHICS, COMPLIANCE, & CONDUCT",
        "verbatim_text": "Commercial gifts/entertainment: Under US $100: No pre-approval. $100-$250: Manager approval. $250-$500: Director approval. Over $500: VP approval. Adult entertainment and cash/gift cards strictly prohibited. Maximum twice in 3-month period with same partner.",
        "page_number": 13,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.98
      },
      {
        "node_id": "CLAUSE-SG-5.4-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "5.4",
        "title": "Home Office Equipment Allowance & Remote Work",
        "section_ref": "SECTION 5: ETHICS, COMPLIANCE, & CONDUCT",
        "verbatim_text": "Employees with an approved 'Remote' or 'Hybrid' location status are eligible for a $500 USD allowance for home office equipment, including monitors. All remote equipment orders must be submitted via a 'Facilities' category ticket in ITSM and shipped to verified remote address.",
        "page_number": 15,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.98
      },
      {
        "node_id": "CLAUSE-SG-5.5-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "5.5",
        "title": "Relocation Allowance & ITSM Ticket Lifecycle",
        "section_ref": "SECTION 5: ETHICS, COMPLIANCE, & CONDUCT",
        "verbatim_text": "Employees transferring to international offices are eligible for a relocation allowance capped at $10,000 USD and must open a Facilities Priority 3 ticket for badging. ITSM Ticket Lifecycle: All tickets must progress sequentially (New -> In Progress -> Resolved -> Closed). Bypassing states is strictly prohibited. Minor facility issues must be Priority 4 - Low.",
        "page_number": 16,
        "jurisdiction": "SG",
        "curation_state": "published",
        "curated_by": "curator-hr@altostrat.com",
        "extraction_confidence": 0.97
      },
      {
        "node_id": "CLAUSE-SG-4.3-01",
        "doc_id": "POL-SG-HANDBOOK-001",
        "version": 2,
        "clause_ref": "4.3",
        "title": "Lodging Caps & Host Gift Allowance",
        "section_ref": "SECTION 4: TRAVEL & EXPENSE (T&E) GUIDELINES",
        "verbatim_text": "Staying with a friend or relative in lieu of a hotel allows you to buy a host gift of up to US $50 per day, backed by valid receipts. Cash or gift card host gifts are strictly prohibited. Personal car use is reimbursable on a per-distance basis in Concur.",
        "page_number": 9,
        "jurisdiction": "SG",
